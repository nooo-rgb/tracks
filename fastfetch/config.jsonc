{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "chafa",
    "source": "/home/overlord/.config/fastfetch/logos/IMG_0825.PNG",
    "width": 32,
    "height": 16,
    "padding": {
      "top": 1,
      "left": 2
    }
  },

  "display": {
    "separator": " 󰇙 ",
    "color": "blue",
    "key": {
      "width": 14
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },

    {
      "type": "custom",
      "format": "┌──────────────── System ────────────────┐"
    },
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    {
      "type": "uptime",
      "key": "  Uptime"
    },
    {
      "type": "packages",
      "key": "  Packages"
    },
    {
      "type": "shell",
      "key": "  Shell"
    },

    {
      "type": "custom",
      "format": "├──────────────── Session ───────────────┤"
    },
    {
      "type": "wm",
      "key": "  Compositor"
    },
    {
      "type": "terminal",
      "key": "  Terminal"
    },
    {
      "type": "terminalfont",
      "key": "  Font"
    },
    {
      "type": "theme",
      "key": "  Theme"
    },
    {
      "type": "cursor",
      "key": "  Cursor"
    },

    {
      "type": "custom",
      "format": "├──────────────── Hardware ──────────────┤"
    },
    {
      "type": "host",
      "key": "  Machine"
    },
    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "gpu",
      "key": "  GPU"
    },
    {
      "type": "memory",
      "key": "  Memory"
    },
    {
      "type": "disk",
      "key": "  Disk"
    },

    {
      "type": "custom",
      "format": "├──────────────── Network ───────────────┤"
    },
    {
      "type": "localip",
      "key": "  LAN"
    },

    {
      "type": "custom",
      "format": "├──────────────── Runtime ───────────────┤"
    },
    {
      "type": "display",
      "key": "  Display"
    },
    {
      "type": "sound",
      "key": "  Audio"
    },
    {
      "type": "processes",
      "key": "  Processes"
    },

    {
      "type": "custom",
      "format": "└──────────────── Palette ───────────────┘"
    },
    "colors"
  ]
}
